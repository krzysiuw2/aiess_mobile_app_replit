{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeConfigPlaneRoutes",
      "Effect": "Allow",
      "Action": "execute-api:Invoke",
      "Resource": [
        "arn:aws:execute-api:eu-central-1:896709973986:0z2j77lbgd/prod/GET/devices/*",
        "arn:aws:execute-api:eu-central-1:896709973986:0z2j77lbgd/prod/PUT/devices/*/sections/*"
      ]
    },
    {
      "Sid": "InvokeBackingLambdasCallerCredentials",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:eu-central-1:896709973986:function:aiess-config-get",
        "arn:aws:lambda:eu-central-1:896709973986:function:aiess-config-put",
        "arn:aws:lambda:eu-central-1:896709973986:function:aiess-config-list-sections"
      ]
    }
  ]
}
